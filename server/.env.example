PORT=3001

# Instagram Graph API Access Token
# Get one from: https://developers.facebook.com/tools/explorer/
# 1. Create a Facebook Developer App (https://developers.facebook.com/apps/)
# 2. Add "Instagram Basic Display" permission
# 3. Generate token with Instagram permissions at: https://developers.facebook.com/tools/explorer/
# 4. For a public account like @itscherryshin, use a Page Access Token if she has an Instagram Business account
#
# Quick start guide:
# 1. Go to https://developers.facebook.com/apps/ and create a new app (type: Business)
# 2. Go to https://developers.facebook.com/tools/explorer/
# 3. Select your app, click "Get Token" → "Generate Access Token"
# 4. Add these permissions: pages_read_engagement, instagram_basic, instagram_content_publish
# 5. Copy the token below
#
# Note: For public Instagram Business/Creator accounts, you need the Instagram Account ID
# Find it at: https://graph.facebook.com/v18.0/ig-user-id?user_token=YOUR_TOKEN&ig_username=itscherryshin

IG_ACCESS_TOKEN=your_access_token_here

# Instagram User/Page ID - required alongside the token, not optional. The token
# says who is asking; this says whose media to read.
# Find it via the Graph API Explorer, or:
#   GET /me/accounts -> instagram_business_account.id
IG_USER_ID=

# YouTube Data API v3 - public channel data, no OAuth required.
# 1. Google Cloud Console -> new project
# 2. Enable "YouTube Data API v3"
# 3. Credentials -> Create API key, then restrict it to that API
# Channel ID: YouTube Studio -> Settings -> Channel -> Advanced
YOUTUBE_API_KEY=your_api_key_here
YOUTUBE_CHANNEL_ID=your_channel_id_here

# TikTok - public oEmbed, no credentials, no app review.
# It resolves one post at a time, so list the posts to mirror explicitly.
# Separate with commas, spaces or newlines. A post that cannot be resolved
# (deleted, private) is skipped rather than breaking the feed.
# oEmbed provides no view or like counts and no publish date, so TikTok cards
# show none rather than invented ones.
# Get each URL from the profile: https://www.tiktok.com/@itscherryshin
#   click a video -> copy the address bar -> .../@itscherryshin/video/7412345678901234567
# Example (commas, spaces or newlines all work):
#   TIKTOK_POST_URLS=https://www.tiktok.com/@itscherryshin/video/7412…, https://www.tiktok.com/@itscherryshin/video/7398…
TIKTOK_POST_URLS=

# Facebook Page - same Meta app as Instagram, but a PAGE access token, not a
# user one. You must be an admin of the Page.
# Permissions: pages_read_engagement, pages_show_list
# Both values are required; setting one alone is treated as unconfigured.
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
